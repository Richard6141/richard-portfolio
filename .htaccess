# ============================================================
# PortfolioSaaS — Routing, securite et performance
# ============================================================

RewriteEngine On

# Encodage des réponses texte (03/10/2026) : llms.txt partait sans charset.
AddDefaultCharset UTF-8

# ----------------------------------------------------------
# Domaine canonique et HTTPS, en un seul saut (03/10/2026).
# Avant : seul HTTPS était forcé, et www.richardsalanon.com servait une
# copie complète du site avec des canoniques en www (audit du 03/10/2026).
# Les hôtes locaux sont exclus : les tests tournent sur localhost:8081.
# Lecture des conditions : (hôte non local) ET (http OU www).
# ----------------------------------------------------------
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://richardsalanon.com%{REQUEST_URI} [L,R=301,NE]

# ----------------------------------------------------------
# Bloquer l'acces direct aux dossiers sensibles
# ----------------------------------------------------------
RewriteRule ^config/ - [F,L]
RewriteRule ^helpers/ - [F,L]
RewriteRule ^includes/ - [F,L]
RewriteRule ^uploads/.*\.php$ - [F,L]

# ----------------------------------------------------------
# Scripts internes appelés directement (03/10/2026) : /index.php et
# /portfolio/*.php répondaient 200, en doublon des URL propres.
# THE_REQUEST ne contient que la requête du visiteur, jamais les
# réécritures internes : les routes plus bas visent toujours ces scripts.
# Le « ? » final de la cible supprime la chaîne de requête.
# ----------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(index\.php|portfolio/[^\s?]*\.php)[\s?] [NC]
RewriteRule ^ /? [R=301,L]

# ----------------------------------------------------------
# NE PAS rediriger ces dossiers (laisser Apache les servir)
# ----------------------------------------------------------
RewriteRule ^api/ - [L]
RewriteRule ^auth/ - [L]
RewriteRule ^dashboard/ - [L]
RewriteRule ^assets/ - [L]
RewriteRule ^uploads/ - [L]
RewriteRule ^portfolio/ - [L]
RewriteRule ^vendor/ - [L]

# Ne pas rediriger les fichiers PHP a la racine (404.php, etc.)
RewriteRule ^[a-z0-9-]+\.php$ - [L]

# ----------------------------------------------------------
# Fichiers SEO — servis par PHP dynamiquement
# ----------------------------------------------------------
RewriteRule ^robots\.txt$  /robots.php  [L]
# sitemap.xml — modifie le 01/09/2026.
# Avant : le fichier STATIQUE etait servi s'il existait, et sitemap.php ne
# servait que de secours. Or Search Console lit sitemap.php sans probleme
# depuis le 28/07/2026, alors qu'elle n'a JAMAIS reussi a lire sitemap.xml
# (« Impossible de recuperer le sitemap », type « Inconnu », zero lecture).
# Le contenu est pourtant identique et irreprochable : teste en HTTP/1.1,
# en HEAD, en requete conditionnelle, en gzip et en brotli, avec l'agent
# Googlebot, huit fois de suite, toujours 200 et 25 363 octets.
# La seule variable qui differe entre les deux URL est ce qui les sert :
# PHP d'un cote, le fichier statique via LiteSpeed de l'autre. On bascule
# donc sur ce qui a fait ses preuves chez Google.
# Le fichier statique reste genere : il sert de secours si PHP tombe, et
# la bascule inverse tient en une ligne.
RewriteRule ^sitemap\.xml$ /sitemap.php [L]
# favicon.ico n'existait pas (404 relevé par l'audit du 03/10/2026) : on sert
# le favicon SVG existant. Remplacé par le logo définitif en vague 0B.
RewriteRule ^favicon\.ico$ /favicon.php [L]

# ----------------------------------------------------------
# Canonicalisation des URL — ajoute le 20/08/2026
# Avant : /a-propos et /a-propos/ repondaient tous deux en 200 (duplication).
# Formes canoniques retenues (identiques au sitemap et aux balises canonical) :
#   /a-propos/  /blog/  /services/     -> AVEC slash final
#   /blog/<slug>  /services/<slug>     -> SANS slash final
# ----------------------------------------------------------
# Ancien slug signale en 404 par Search Console le 29/08/2026. Il n'est lie
# depuis aucune page du site : il vient donc d'un lien externe ou d'une
# ancienne version. Rediriger vaut mieux que laisser un 404 : le visiteur
# arrive sur la page equivalente et le lien entrant garde sa valeur.
RewriteRule ^services/creation-de-site-web/?$ /services/site-vitrine-professionnel [R=301,L]

RewriteRule ^(a-propos|blog|services)$ /$1/ [R=301,L]
RewriteRule ^(blog|services)/([a-z0-9_-]+)/$ /$1/$2 [R=301,L]

# ----------------------------------------------------------
# Pages articles de blog — URLs propres pour le SEO
# ----------------------------------------------------------
RewriteRule ^blog/?$ /portfolio/blog-index.php [QSA,L]
RewriteRule ^blog/([a-z0-9_-]+)/?$ /portfolio/article.php?slug=$1 [QSA,L]

# ----------------------------------------------------------
# Pages services — URLs propres pour le SEO
# ----------------------------------------------------------
RewriteRule ^services/?$ /portfolio/services-index.php [QSA,L]
RewriteRule ^services/([a-z0-9-]+)/?$ /portfolio/service.php?slug=$1 [QSA,L]

# ----------------------------------------------------------
# Page À propos
# ----------------------------------------------------------
RewriteRule ^a-propos/?$ /portfolio/a-propos.php [QSA,L]
# /contact — ajoutee le 20/08/2026. L'URL etait referencee par llms.txt mais
# repondait 404. La forme sans barre finale est la canonique ; /contact/ redirige.
RewriteRule ^contact/$ /contact [R=301,L]
RewriteRule ^contact$ /portfolio/contact.php [QSA,L]

# Realisations et pages locales — ajoutees le 20/08/2026.
# Les projets n'avaient aucune URL (simple ancre #portfolio) et les 21 villes
# annoncees en pied de page ne pointaient nulle part.
RewriteRule ^realisations$ /realisations/ [R=301,L]
RewriteRule ^realisations/$ /portfolio/realisations-index.php [QSA,L]
RewriteRule ^realisations/([a-z0-9_-]+)/$ /realisations/$1 [R=301,L]
RewriteRule ^realisations/([a-z0-9_-]+)$ /portfolio/realisation.php?slug=$1 [QSA,L]
# Catalogue des formations — ajoute le 05/09/2026. Le hub /formations/ liste
# les 9 formations du registre (formation-*), servies elles par route.php.
RewriteRule ^formations$ /formations/ [R=301,L]
RewriteRule ^formations/$ /portfolio/formations.php [QSA,L]
RewriteRule ^zones$ /zones/ [R=301,L]
RewriteRule ^zones/$ /portfolio/zones-index.php [QSA,L]
RewriteRule ^developpeur-web-([a-z0-9-]+)/$ /developpeur-web-$1 [R=301,L]
RewriteRule ^developpeur-web-([a-z0-9-]+)$ /portfolio/ville.php?ville=$1 [QSA,L]

# Les pages digitalisation sont desormais servies par le registre generique
# (data/sujets/) via route.php : leurs regles dediees sont devenues inutiles.

# ----------------------------------------------------------
# Servir directement les fichiers statiques qui existent
# (cle IndexNow, txt, images, pdf...) sans passer par le portfolio
# ----------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.(txt|xml|ico|png|jpe?g|gif|svg|webp|avif|pdf|woff2?|css|js)$ - [L]

# ----------------------------------------------------------
# Racine du site → portfolio public (mono-utilisateur)
# ----------------------------------------------------------
RewriteRule ^$ /portfolio/index.php [QSA,L]

# ----------------------------------------------------------
# Vrai 404 — corrige le 20/08/2026
# Avant : "RewriteRule ^(.*)$ /portfolio/index.php" renvoyait la PAGE D'ACCUEIL
# en HTTP 200 pour n'importe quelle URL inexistante (soft-404). Google decouvrait
# ainsi une infinite d'URL en 200 et gaspillait son budget de crawl.
# portfolio/index.php ne fait aucun routage interne : il rend toujours l'accueil,
# donc aucune URL legitime ne dependait de ce catch-all (verifie sur les 43 pages).
# 404.php envoie bien http_response_code(404) et porte <meta name="robots" content="noindex">.
# ----------------------------------------------------------
# Resolveur generique (21/08/2026). Toute URL non reconnue plus haut passe
# par route.php, qui consulte le registre data/sujets.php : si le slug y
# correspond, la page est rendue ; sinon route.php renvoie un vrai 404.
# C'est ce qui permet de publier "odoo-cotonou" ou "dolibarr-lome" en
# deposant un simple fichier, sans jamais revenir editer ce fichier.
RewriteRule ^([a-z0-9-]+)/$ /$1 [R=301,L]
RewriteRule ^([a-z0-9-]+)$ /portfolio/route.php?p=$1 [QSA,L]
RewriteRule ^(.*)$ /404.php [L]

ErrorDocument 403 /403.php
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php

# ----------------------------------------------------------
# Bloquer les fichiers caches et sensibles
# ----------------------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(^\.env|\.env\..*)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|log|md|example\.php)$">
    Require all denied
</FilesMatch>

# ----------------------------------------------------------
# Endpoints de debug/test — bloques le 20/08/2026
# Ils repondaient en HTTP 200 en production et divulguaient :
#   diagnostic.php : version PHP, DB_NAME, DB_USER, DB_HOST, liste des 23 tables
#   test-mail.php  : SMTP_HOST/PORT/USER + chemin absolu du serveur + stack trace
#   debug.php      : slug utilisateur, template actif, etat des includes
#   test-api.php   : etat de session et chemin de connexion
# A supprimer du serveur de production ; ce blocage est la ceinture de securite.
# ----------------------------------------------------------
# migrate.php refuse deja toute execution hors ligne de commande (PHP_SAPI),
# mais il modifie le schema : on le rend aussi inatteignable par le web.
<FilesMatch "^(debug|diagnostic|test500|migrate|test-[a-z0-9-]+)\.php$">
    Require all denied
</FilesMatch>

# ----------------------------------------------------------
# Cache serveur LiteSpeed — desactive pour les pages (05/09/2026).
# Constat sur le nouvel hebergement : apres un deploiement, l'ancienne
# version des pages restait servie plusieurs minutes malgre le
# Cache-Control no-cache, car le cache LiteSpeed de Hostinger est un cache
# SERVEUR qui ne lit pas cet en-tete navigateur. Les assets, eux, restent
# caches par le navigateur via mod_expires (URLs versionnees ?v=filemtime).
# ----------------------------------------------------------
<IfModule LiteSpeed>
    CacheDisable public /
</IfModule>

# ----------------------------------------------------------
# Headers de securite
# ----------------------------------------------------------
<IfModule mod_headers.c>
    # Revalidation systematique du HTML, voir le bloc mod_expires plus bas.
    <FilesMatch "\.(php|html)$">
        Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
    </FilesMatch>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header unset X-Powered-By
</IfModule>

# ----------------------------------------------------------
# Compression GZIP
# ----------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------
# Cache navigateur
# ----------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    # Duree portee a 1 an le 20/08/2026 : les assets sont deja versionnes
    # (portfolio-v2.css?v=..., portfolio-v2.js?v=...), donc toute modification
    # change l'URL. Un TTL long est sans risque et evite de retelecharger a chaque semaine.
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    # Le serveur annonce le JS en "application/x-javascript" : sans ces deux
    # variantes, la regle ne s'appliquait pas et portfolio-v2.js restait a
    # 7 jours (constate le 20/08/2026 via PageSpeed malgre la regle ci-dessous).
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 month"

    # Le HTML ne doit JAMAIS etre mis en cache (21/08/2026).
    # Il n'avait aucun en-tete: les navigateurs lui appliquaient donc un
    # cache heuristique base sur Last-Modified et continuaient de servir
    # une ancienne page, qui referencait l'ancienne URL du CSS. Les
    # modifications de style paraissaient absentes alors que le serveur
    # envoyait bien la nouvelle version.
    # Les assets, eux, restent a un an: ils sont versionnes par ?v=filemtime,
    # donc toute modification change leur URL.
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ----------------------------------------------------------
# Empecher le listing de repertoires
# ----------------------------------------------------------
Options -Indexes
